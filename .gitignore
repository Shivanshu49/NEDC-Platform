# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep real secrets out of git, but DO commit the example template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local-only notes and tooling state
.claude/
CLAUDE.md
SETUP.md
SECURITY.md

# Uploaded source documents (mentor CVs, EDP schedule, etc.) — content is added to
# the site/content config; keep the raw source files out of git
/DOC-*.pdf
/Schedule_*.pdf
/*.pdf

# Raw camera source photos — the optimized versions live in /public, commit those
/DSC*.JPG
/DSC*.jpg
/image.png
