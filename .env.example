# ────────────────────────────────────────────────────────────────────────────
# NEDC Platform — environment variables
#
# HOW TO USE:
#   1. Copy this file to `.env.local`        (cp .env.example .env.local)
#   2. Fill in the real values from each service's dashboard.
#   3. `.env.local` is git-ignored — never commit real secrets.
#
# NAMING RULE:
#   NEXT_PUBLIC_*  → shipped to the browser. Safe values ONLY (URLs, public IDs).
#   everything else → server-only secrets. NEVER prefix a secret with NEXT_PUBLIC_.
#
# On Vercel, add these same variables under Project → Settings → Environment
# Variables (set NEXT_PUBLIC_SITE_URL to your real domain in Production).
# ────────────────────────────────────────────────────────────────────────────


# ── Phase 1 — Supabase (database, auth, storage) ────────────────────────────
# Project Settings → Data API / API Keys in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — used by the payment webhook to
# create enrollments. Set it now; it's first USED in Phase 3. NEVER expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the site. Used for auth redirects / OAuth callback and email links.
# Local dev: http://localhost:3000   |   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── Phase 3 — Razorpay (payments, INR) ──────────────────────────────────────
# Razorpay Dashboard → Settings → API Keys. Use TEST keys during development.
# The Key ID is safe in the browser (the Checkout widget needs it). We only use
# the NEXT_PUBLIC_ form — the server reads the same value from it.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-only secrets.
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Settings → Webhooks. A secret YOU choose; used to verify
# webhook signatures so only Razorpay can confirm a payment.
RAZORPAY_WEBHOOK_SECRET=


# ── Phase 3 — Resend (transactional email) ──────────────────────────────────
# Resend Dashboard → API Keys.
RESEND_API_KEY=
# The verified "from" address, e.g. "NEDC <noreply@your-domain.com>".
RESEND_FROM_EMAIL=
# Where /edp landing-page registrations are sent (enquiry on submit + payment
# confirmation) — comma-separated, server-only. Recipients live HERE, not in code.
EDP_NOTIFY_EMAILS=info@nedc.co.in,ppcexecutive.webslogin@gmail.com


# ── Phase 5 (LATER) — Zoom (live sessions + recordings) ─────────────────────
# Zoom Marketplace → build a "Server-to-Server OAuth" app.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Secret Token from the Zoom app's "Feature → Event Subscriptions" — used to
# verify the recording-completed webhook.
ZOOM_WEBHOOK_SECRET_TOKEN=


# ── Phase 5 — Mux (recording hosting + signed playback) ─────────────────────
# Mux Dashboard → Settings → Access Tokens.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Mux → Settings → Signing Keys (for signed, share-proof playback URLs).
# MUX_SIGNING_KEY_PRIVATE is the base64-encoded private key Mux gives you.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=


# ── Phase 5 — Inngest (background jobs) ─────────────────────────────────────
# Inngest Dashboard → Manage keys. For local dev, run `npx inngest-cli dev` and
# these can be left blank; INNGEST_SIGNING_KEY is REQUIRED in production — the
# /api/inngest route rejects every request with 503 if it's missing in prod, so
# forged background-job events are impossible.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=


# ── Rate limiting — Upstash Redis (recommended in production) ────────────────
# Upstash Console → Redis → create a database → REST API. If these are unset,
# app-level rate limiting is a safe no-op (allows all) so local dev still works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── SMS confirmation (PLANNED — not built yet) ──────────────────────────────
# Leave blank for now. When set, lib/sms.ts will send an SMS on enrollment via
# your chosen provider (MSG91 / Twilio / Gupshup). No provider is wired today.
SMS_API_KEY=


# ── Keep-alive cron (Supabase Free anti-pause) ──────────────────────────────
# A Vercel Cron (see vercel.json) calls /api/keep-alive daily so a FREE-tier
# Supabase project never hits ~7 days of inactivity and gets paused. Set this to
# any long random string (e.g. `openssl rand -hex 32`); Vercel Cron sends it
# automatically as a Bearer token and the route rejects requests without it.
# In PRODUCTION the route fails closed (401) if this is unset, so it is required
# there. Add it in Vercel → Settings → Environment Variables (Production).
#
# The DATABASE BACKUP uses a SEPARATE secret, SUPABASE_DB_URL, stored as a GitHub
# Actions secret (Repo → Settings → Secrets → Actions) — NOT an app env var.
# See .github/workflows/db-backup.yml for setup.
CRON_SECRET=
